# Copy this file to .env (or .env.local) and adjust it. Never commit your real .env file.
# Only variables starting with VITE_ reach the browser: NEVER put secrets here.

# Base URL of the existing hotel-menara-backend API, including /api/v1, without a trailing slash.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional: request timeout in milliseconds (default 15000).
VITE_API_TIMEOUT_MS=15000
