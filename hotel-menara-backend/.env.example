# ============================================================
# Hotel Menara Hammamet backend - environment template
# Copy to .env (run `npm run env:init`) and fill in the values.
# NEVER commit your real .env file.
# ============================================================

NODE_ENV=development
PORT=4000

# --- MongoDB (REQUIRED) -------------------------------------
# MongoDB Atlas connection string. It MUST include a database name
# (here: hotel_menara) before the "?".
MONGODB_URI=mongodb+srv://isra_app:isra00@cluster0.kym8o9p.mongodb.net/hotel_menara?retryWrites=true&w=majority
# Separate database used ONLY by integration tests (NODE_ENV=test).
# Its name MUST end with "_test" and differ from the one above.
# Leave empty to skip database integration tests.
MONGODB_URI_TEST=

# --- Security (REQUIRED) ------------------------------------
# At least 32 characters. `npm run env:init` generates one for you.
JWT_SECRET=change-me-run-npm-run-env-init
JWT_EXPIRES_MINUTES=480
BCRYPT_ROUNDS=12

# Comma-separated list of front-end origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to true when running behind a reverse proxy (Render, Nginx, ...).
TRUST_PROXY=false

# Rate limit: max requests per IP per 15 minutes on the whole API.
# (Stricter limits on login and public forms apply only when NODE_ENV=production.)
RATE_LIMIT_MAX=1000

# Timezone used to decide what "today" means for bookings.
HOTEL_TIMEZONE=Africa/Tunis

LOG_LEVEL=info

# --- Optional: e-mail notifications -------------------------
# When EMAIL_ENABLED=false the rest of the API works normally.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where booking / contact notifications are sent.
HOTEL_NOTIFY_EMAIL=

# --- Optional: AI assistant (OpenAI) ------------------------
# When AI_ENABLED=false, POST /api/v1/ai/assistant answers 503 and
# nothing else is affected. The key stays on the server only.
AI_ENABLED=false
OPENAI_API_KEY=
# A chat model available on YOUR OpenAI account.
OPENAI_MODEL=
