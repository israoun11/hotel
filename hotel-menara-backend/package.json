{
  "name": "hotel-menara-backend",
  "version": "1.0.0",
  "description": "REST API backend for Hotel Menara Hammamet (demo data only)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:init": "node scripts/init-env.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --require ./tests/setup.js --test \"tests/**/*.test.js\"",
    "check:docs": "node scripts/check-docs.js",
    "postman:generate": "node scripts/generate-postman.js",
    "admin:create": "node src/scripts/createAdmin.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset-demo": "node src/scripts/seed.js --reset-demo",
    "verify": "npm run check:syntax && npm run lint && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0"
  }
}
